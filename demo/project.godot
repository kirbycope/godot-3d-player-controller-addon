; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Godot 3D Player Controller v3"
config/version="3.0.15"
run/main_scene="uid://b8qyk1m2p3d5x"
config/features=PackedStringArray("4.8", "Forward Plus")

[audio]

driver/enable_input=true

[autoload]

[debug]

file_logging/enable_file_logging=true

[display]

window/size/viewport_width=1280
window/size/viewport_height=800
window/stretch/mode="canvas_items"

[importer_defaults]

texture={
&"compress/mode": 1,
&"detect_3d/compress_to": 0,
&"process/size_limit": 512
}

[input_devices]

joypads/ignore_joypad_on_unfocused_application=true
pointing/emulate_mouse_from_touch=false

[layer_names]

3d_physics/layer_10="Weapons"
3d_physics/layer_11="Hittable"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

textures/vram_compression/import_etc2_astc=true

rendering_device/d3d12/max_resource_descriptors=1000000
rendering_device/driver.windows="d3d12"

[shader_globals]

weather_wind_strength={
"type": "float",
"value": 0.0
}
weather_wind_direction={
"type": "vec3",
"value": Vector3(1, 0, 0)
}
weather_precipitation_strength={
"type": "float",
"value": 0.0
}
weather_foliage_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}
weather_grass_tint={
"type": "color",
"value": Color(1, 1, 1, 1)
}

[steam]

initialization/app_data/app_id=480
