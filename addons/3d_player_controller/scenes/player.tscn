[node name="CameraRayCast" type="RayCast3D" parent="CameraMount/CameraSpringArm/Camera3D" unique_id=45396852]
editor_description = "The interaction ray. What it hits resolves to the nearest ancestor with display_menu, which the Camera stores as looking_at; collide_with_areas is on so a prompt volume counts."
