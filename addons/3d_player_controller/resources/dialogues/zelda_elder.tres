[gd_resource type="Resource" script_class="Dialogue" load_steps=10 format=3 uid="uid://c7dialoguezelda"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/dialogue.gd" id="1_dialogue"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/dialogue_line.gd" id="2_line"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/dialogue_choice.gd" id="3_choice"]
[ext_resource type="Resource" path="res://addons/3d_player_controller/resources/quests/zelda_camp.tres" id="4_quest"]

[sub_resource type="Resource" id="Resource_choice_yes"]
script = ExtResource("3_choice")
text = "I will deal with them."
next = 1
starts_quest = ExtResource("4_quest")

[sub_resource type="Resource" id="Resource_choice_no"]
script = ExtResource("3_choice")
text = "Not my fight."
next = -1

[sub_resource type="Resource" id="Resource_line_greeting"]
script = ExtResource("2_line")
text = "Traveller. Raiders sit in a camp east of here and the shrine past them holds what they took from us. Take the sword from the stand and the shield from the crate; they are yours either way."
choices = Array[ExtResource("3_choice")]([SubResource("Resource_choice_yes"), SubResource("Resource_choice_no")])
condition = 1
condition_quest = ExtResource("4_quest")

[sub_resource type="Resource" id="Resource_line_task"]
script = ExtResource("2_line")
text = "Three of them. Hold Focus to face one and strike; the shield takes the rest. The chest is on the shrine behind their camp."
ends_dialogue = true
entry = false

[sub_resource type="Resource" id="Resource_line_waiting"]
script = ExtResource("2_line")
text = "East, past the pond. The bow on the barrel is a gift if you would rather keep your distance; the arrows are in the pouch beside it."
ends_dialogue = true
condition = 2
condition_quest = ExtResource("4_quest")

[sub_resource type="Resource" id="Resource_line_done"]
script = ExtResource("2_line")
text = "The camp is quiet and the shrine is ours again. Two potions, as promised. The cliff to the west is worth the climb; the glider knows the way down."
ends_dialogue = true
condition = 3
condition_quest = ExtResource("4_quest")

[resource]
script = ExtResource("1_dialogue")
lines = Array[ExtResource("2_line")]([SubResource("Resource_line_greeting"), SubResource("Resource_line_task"), SubResource("Resource_line_waiting"), SubResource("Resource_line_done")])
