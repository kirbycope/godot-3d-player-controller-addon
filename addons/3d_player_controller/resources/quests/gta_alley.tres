[gd_resource type="Resource" script_class="Quest" load_steps=6 format=3 uid="uid://c7questgtaalley"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Resource" path="res://addons/3d_player_controller/resources/items/cash.tres" id="3_cash"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_gunmen"]
script = ExtResource("2_objective")
id = &"defeat_gunman"
description = "Clear the gang out of the lot"
required = 3

[sub_resource type="Resource" id="Resource_card"]
script = ExtResource("2_objective")
id = &"take_card"
description = "Take the data card from their stash"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"gta_alley"
title = "The Lot"
description = "The gang in the lot across the street took the fixer's ledger. Get it back, whatever it takes; the fixer pays cash."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_gunmen"), SubResource("Resource_card")])
rewards = Dictionary[ExtResource("item_script"), int]({
ExtResource("3_cash"): 500
})
tracked_on_start = true
