[sub_resource type="Resource" id="Resource_raiders"]
script = ExtResource("2_objective")
id = &"defeat_raider"
description = "Drive the raiders from their camp"
required = 3

[sub_resource type="Resource" id="Resource_chest"]
script = ExtResource("2_objective")
id = &"open_chest"
description = "Open the chest on the shrine"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"zelda_camp"
title = "The Raiders' Camp"
description = "Three raiders have made camp east of the village and the shrine beyond it holds what they stole. The elder will pay in potions."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_raiders"), SubResource("Resource_chest")])
rewards = Dictionary[ExtResource("item_script"), int]({
ExtResource("3_potion"): 2
})
tracked_on_start = true
