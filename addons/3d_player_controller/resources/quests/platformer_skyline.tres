[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3 uid="uid://c7questskyline1"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_coins"]
script = ExtResource("2_objective")
id = &"collect_coin"
description = "Collect the coins"
required = 15

[sub_resource type="Resource" id="Resource_flag"]
script = ExtResource("2_objective")
id = &"reach_flag"
description = "Reach the flag on the top island"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"platformer_skyline"
title = "Skyline"
description = "Islands in the sky, coins on every one, and a flag on the highest."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_coins"), SubResource("Resource_flag")])
rewards = Dictionary[ExtResource("item_script"), int]({})
tracked_on_start = true
