[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3 uid="uid://c7questhorror01"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_key"]
script = ExtResource("2_objective")
id = &"find_key"
description = "Find the cellar key"
required = 1

[sub_resource type="Resource" id="Resource_out"]
script = ExtResource("2_objective")
id = &"get_out"
description = "Get out"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"horror_cellar"
title = "The Cellar"
description = "Something in the dark only moves when the light is off it. The key is down here somewhere; the door is at the top of the stairs."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_key"), SubResource("Resource_out")])
rewards = Dictionary[ExtResource("item_script"), int]({})
tracked_on_start = true
