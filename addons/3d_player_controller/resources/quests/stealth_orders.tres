[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3 uid="uid://c7queststealth1"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_intel"]
script = ExtResource("2_objective")
id = &"take_orders"
description = "Take the sealed orders from the pavilion"
required = 1

[sub_resource type="Resource" id="Resource_exit"]
script = ExtResource("2_objective")
id = &"reach_exit"
description = "Slip out through the far gate"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"stealth_orders"
title = "The Orders"
description = "Three guards walk the grounds. Crouch to stay under their eyes, strike one from behind, and take the orders from the pavilion before the far gate."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_intel"), SubResource("Resource_exit")])
rewards = Dictionary[ExtResource("item_script"), int]({})
tracked_on_start = true
