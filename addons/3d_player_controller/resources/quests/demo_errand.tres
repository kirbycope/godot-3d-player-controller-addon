[gd_resource type="Resource" script_class="Quest" load_steps=6 format=3 uid="uid://c7questdemo001"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Resource" path="res://addons/3d_player_controller/inventory/resources/items/apple.tres" id="3_apple"]

[sub_resource type="Resource" id="Resource_talk"]
script = ExtResource("2_objective")
id = &"talk_guide"
description = "Talk to the Guide"
required = 1

[sub_resource type="Resource" id="Resource_swim"]
script = ExtResource("2_objective")
id = &"swim"
description = "Take a dip in the pool"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"demo_errand"
title = "The Courtyard Errand"
description = "The Guide by the courtyard has a small errand: a swim in the pool. There is an apple in it for you."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_talk"), SubResource("Resource_swim")])
rewards = Dictionary[ExtResource("3_apple"), int]({
ExtResource("3_apple"): 2
})
tracked_on_start = true
