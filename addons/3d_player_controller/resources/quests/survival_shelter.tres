[gd_resource type="Resource" script_class="Quest" load_steps=6 format=3 uid="uid://c7questsurvive1"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_axe"]
script = ExtResource("2_objective")
id = &"craft_axe"
description = "Craft a stone axe at the workbench"
required = 1

[sub_resource type="Resource" id="Resource_pick"]
script = ExtResource("2_objective")
id = &"craft_pickaxe"
description = "Craft a stone pickaxe"
required = 1

[sub_resource type="Resource" id="Resource_shelter"]
script = ExtResource("2_objective")
id = &"build_shelter"
description = "Build a shelter before you starve"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"survival_shelter"
title = "Shelter"
description = "Washed up with nothing. Branches and loose stones on the beach make an axe; the axe fells trees, a pickaxe breaks the boulders, and eight logs and four stones make a roof. Berries and the stream keep you going."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_axe"), SubResource("Resource_pick"), SubResource("Resource_shelter")])
rewards = Dictionary[ExtResource("item_script"), int]({})
tracked_on_start = true
