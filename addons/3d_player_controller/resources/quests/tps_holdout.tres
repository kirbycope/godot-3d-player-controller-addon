[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3 uid="uid://c7questtpshold1"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_waves"]
script = ExtResource("2_objective")
id = &"clear_wave"
description = "Hold the compound"
required = 3

[sub_resource type="Resource" id="Resource_extract"]
script = ExtResource("2_objective")
id = &"reach_extraction"
description = "Reach the extraction point"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"tps_holdout"
title = "Holdout"
description = "Three waves are coming over the wall. Hold the compound from cover; the gate opens when it is over."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_waves"), SubResource("Resource_extract")])
rewards = Dictionary[ExtResource("item_script"), int]({})
tracked_on_start = true
