[gd_resource type="Resource" script_class="Quest" load_steps=5 format=3 uid="uid://c7questflight01"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_rings"]
script = ExtResource("2_objective")
id = &"pass_ring"
description = "Fly through the rings in order"
required = 8

[sub_resource type="Resource" id="Resource_land"]
script = ExtResource("2_objective")
id = &"land"
description = "Land on the far platform"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"flight_rings"
title = "Ring Run"
description = "Jump, and jump again to take off. The rings light up one at a time; fly through the lit one, and set down on the platform at the end."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_rings"), SubResource("Resource_land")])
rewards = Dictionary[ExtResource("item_script"), int]({})
tracked_on_start = true
