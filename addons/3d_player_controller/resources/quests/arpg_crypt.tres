[gd_resource type="Resource" script_class="Quest" load_steps=6 format=3 uid="uid://c7questarpgcryp"]

[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest.gd" id="1_quest"]
[ext_resource type="Script" path="res://addons/3d_player_controller/scripts/quest_objective.gd" id="2_objective"]
[ext_resource type="Resource" path="res://addons/3d_player_controller/resources/items/gold_coin.tres" id="3_coin"]
[ext_resource type="Script" path="res://addons/3d_player_controller/inventory/scripts/item.gd" id="item_script"]

[sub_resource type="Resource" id="Resource_waves"]
script = ExtResource("2_objective")
id = &"clear_wave"
description = "Clear the crypt's halls"
required = 3

[sub_resource type="Resource" id="Resource_boss"]
script = ExtResource("2_objective")
id = &"slay_lord"
description = "Slay the Crypt Lord"
required = 1

[resource]
script = ExtResource("1_quest")
id = &"arpg_crypt"
title = "The Crypt"
description = "Ghouls in the halls, gold and potions on their corpses, and the Crypt Lord at the end. Fireball is on the shoulder button."
objectives = Array[ExtResource("2_objective")]([SubResource("Resource_waves"), SubResource("Resource_boss")])
rewards = Dictionary[ExtResource("item_script"), int]({
ExtResource("3_coin"): 200
})
tracked_on_start = true
