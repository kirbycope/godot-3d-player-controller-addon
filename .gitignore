# Texture .import files carry each consuming project's importer settings, so they cannot be shared;
# Godot regenerates them harmlessly on import.
#
# Model .import files are different and must be tracked. They define the imported node structure -
# skeleton naming, root type, animation handling - so regenerating them with defaults renames or
# removes nodes and breaks any scene that inherits from the model.
*.import
!*.glb.import
!*.gltf.import
!*.fbx.import
!*.obj.import
!*.dae.import
!*.blend.import

.godot/
